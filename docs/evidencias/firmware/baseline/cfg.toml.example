# Configuração do firmware. Copie para cfg.toml (ignorado pelo git) e preencha.
# O build valida os valores e recompila quando este arquivo muda.

# Rede Wi-Fi de 2,4 GHz. Senha vazia: rede aberta.
wifi_ssid = ""
wifi_password = ""

# Local da consulta à Open-Meteo, em graus (PRD, D6; padrão: Boa Vista/RR).
latitude = 2.82
longitude = -60.67

# Intervalo entre ciclos (PRD, D5b: 5 s). Mínimo de 1000 ms, o intervalo de
# amostragem do DHT11.
cycle_interval_ms = 5000

# Tempo limite da consulta à Open-Meteo (PRD, D5c: 3 s). Deve ser menor que o
# intervalo entre ciclos, para que uma consulta lenta não atrase o ciclo seguinte.
http_timeout_ms = 3000

# Intervalo entre consultas à Open-Meteo (PRD, D5a: 15 min). Nos experimentos C3–C5, 5000,
# para observar falha e recuperação externas a cada ciclo, sem esperar a próxima consulta
# (PRD, D10).
external_refresh_ms = 900000

# GPIO de dados do DHT11 (padrão: 4, rotulado D4 no DevKit). O build aceita só GPIOs
# bidirecionais fora da Flash e da serial, e avisa quando o pino é de strapping (0, 2, 5, 12,
# 15): o pull-up do DHT11 nesses pinos pode impedir a gravação ou o boot.
dht11_gpio = 4

# GPIO que alimenta o DHT11 (opcional; sem a chave, o VCC vai no 3V3). Com ele, o firmware
# desliga e religa o sensor a cada 3 falhas seguidas de leitura. O build aceita os mesmos
# GPIOs de dht11_gpio, exceto o próprio, e avisa sobre os pinos de strapping.
# dht11_power_gpio = 23
